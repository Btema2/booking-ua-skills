NODE_ENV=development
PORT=3000

# Adds the Secure flag to the session cookie. Must be true when serving over HTTPS;
# leave false for the plain-http local/compose run or login silently stops working.
COOKIE_SECURE=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking
TEST_DATABASE_URL=postgres://booking:booking@localhost:5433/booking_test

# Minutes before a booking ends that its author is notified — only if the
# room's next slot is already taken. Interpolated into the notification text.
NOTIFY_BEFORE_MINUTES=10

