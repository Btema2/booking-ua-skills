{
  "name": "booking-ua-skills-task",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w packages/core && npm run build -w apps/web && npm run build -w apps/api && node scripts/copy-web-dist.js",
    "pretest": "npm run build -w packages/core",
    "test": "npm test --workspaces --if-present",
    "test:integration": "npm run test:integration -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "lint": "eslint apps packages",
    "format:check": "prettier --check apps packages"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
